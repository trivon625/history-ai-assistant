<div class="home-container">
  <!-- Hero section -->
  <div class="hero-section d-flex align-items-center">
    <div class="container">
      <div class="row align-item-center">
        <div class="col-lg-6 col-md-12 text-white pt-lg-5">
          <% if user_signed_in? %>
          <h3 class="text-muted mb-3 style="font-family: 'Times New Roman', serif;">Welcome, <%= current_user.name %> 👋</h3>
          <% end %>
          <h1 class="fw-bold mb-3" style="font-family: 'Times New Roman', serif;
          font-size: 3rem;">
          Learn History with AI 🏛️</h1>
          <p class="lead mb-4" style="max-width:90%;">Explore the past like never before with our interactive AI learning platform</p>
      
    <div class="hero-buttons d-flex gap-3 flex-wrap">
    <% if user_signed_in? %>
      <%= link_to "See All Topics →", topics_path, class: "btn btn-lg text-white",
      style: "background-color: rgb(12,52,112); font-family: 'Times new Roman', serif;" %>
    <% else %>
      <%= link_to "Get Started", new_user_registration_path, class: "btn-get-started" %>
      <%= link_to "Log in", new_user_session_path, class: "btn-login-hero" %>
    <% end %>
   </div>
  </div>

  <div class="col-lg-6 cold-md-12 text-center mt-4 mt-lg-0">
            <%= image_tag "homepage.png", class: "img-fluid hero-img", alt: "History AI",
            style: "max-height: 550px; width: auto; object-fit: contain;" %>
          </div>
      </div>
    </div>
  </div>

  
  <!-- Topics preview (visible to logged OUT users only) -->
  <% unless user_signed_in? %>
    <div class="container pb-5 mt-5">
      <div class="row g-4 justify-content-center">
        <% @topics.each do |topic| %>
         <div class="col-lg-4 col-md-6">
          <div class="feature-card h-100">
            
              <h3 class="topic-title"><%= topic.title %></h3>
              <p class="topic-desc"><%= topic.description %></p>
              <%= link_to "Explore →", topic_path(topic), class: "btn-explore-yellow" %>
            </div>
          </div>
          <% end %>
        </div>

      </div>
    
  <% end %>
</div>

<style>
.col-md-4{
  display: flex;
}
.home-container {
  background-color: rgb(245, 236, 223);
  min-height: 100vh;
  overflow-x: hidden;
}
.hero-section h1{
  padding: 80px 0;
  width: 100 % ;
}
.hero-section .container {
  max-width: 1200px !important ;
  padding-right: 0 !important;
  margin-right: 0 !important;
  }
  @media (max-width: 991px){
    .hero-section {
      padding: 40px 0;
      text-align: center;
    }
    .hero.buttons {
      justify-content: center;
    }
    .hero-img{
      max-height: 350px !important;
      margin-top: 20px;
      h1{
        font-size: 2.5rem !important;
      }
    }
  }
.hero-section h1 {
  color: rgb(12,52,112);
  font-weight: 800;
  font-size: 3.5 rem !important;
  line-height: 1.2;
  margin-bottom: 20px;
  max-width: 90 % ;
  overflow: hidden;
  width: 100 % ;
  position: relative;
  padding-top: 0 !important;
  margin-top: 0 !important;
  
}
.hero-section p.lead {
  color: rgba(12,52,112,0.8);
  overflow: hidden;
  position: relative;
  font-size: 1.1rem;
  max-width: 85 % ;
  margin-bottom: 30px;
}
.hero-img{
  display: block;
  width: 100 % ;
  height: auto;
  object-fit: cover;
  margin-right: 0;
  float: right;
  position: relative;
  right: 0;
  margin-top: -22px !important;
  float: right;
  z-index: 1;

}
.container {
  margin-left: auto !important;
  margin-right: auto !important;
  padding-left: 15px !important;
  padding-right: 15px !important;
}
.col-md-6 .text-center {
  padding-top: 0 !important;
  margin-top: 0 !important;
}
.col-md-6 .hero-img {
  transform: scale(1.15);
  z-index: 1;
  position: relative;
  left: -40px;
  bottom: -50px;
  transition: all 0.3 ease;
  display: block;
  max-width: 100 % ;
  height: auto;
}
.btn-get-started {
  background-color: rgb(12,52,112);
  color: rgba(225, 225, 225, 1);
  padding: 12px 30px;
  border-radius: 10px;
  font-weight: bold;
  text-decoration: none;
  display: inline-block;
  transition: 0.3s;
  max-width: 160px;
  text-align: center;
}
.btn-get-started:hover {
  background-color: rgba(20,40,80,1);
  transform: translateY(-2px);
}
.btn-login-hero {
  background-color: rgba(225, 193, 7, 1);
  padding: 12px 30px;
  border-radius: 10px;
  font-weight: bold;
  text-decoration: none;
  display: inline-block;
  transition: 0.3s;
  max-width: 160px;
  text-align: center;
}
.btn-login-hero:hover {
  background-color: rgba(225, 213, 79, 1);
  transform: translateY(-2px);
}
.hero-buttons {
  display: flex;
  justify-content: center;
  gap: 20px;
  margin-top: 30px;
  width: 100 % ;
  max-width: 500px;
}
.container.pb-5 {
  background-color: transparent;
  border: none;
  box-shadow: none;
  position: relative;
  z-index: 5;
  margin-top: 50px;
  
}
.feature-card {
  flex: 1;
  background-color: rgb(12,52,112) !important;
  padding: 30px;
  border-radius: 20px;
  border: 1px solid rgba(225, 225, 225, 0.1);
  text-align: center;
  height: 100 % ;
  box-shadow: 0 10px 30px rgba(0,0,0,0.2);
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
  
}

.topic-title{
  color: rgba(225, 193, 7, 1) !important;
  font-family: 'Times new Roman', serif;
  font-weight: bold;
  font-size: 26px;
  margin-bottom: 15px;
}
.topic-desc {
  font-size 16px;
  color: rgba(225, 193, 7, 1) !important;
  line-height: 1.6;
  margin-bottom: 25px;
  
}
.btn-explore-yellow {
  background-color: rgba(225, 193, 7, 1);
  color: rgba(10, 25, 49, 1);
  font-weight: bold;
  text-decoration: none;
  font-size: 18px;
  margin-top: auto;
  padding-top: 12px 25px;
  border-radius: 10px;
  display: inline-block;
  transition: 0.3s;
  border: none;
}
.btn-explore-yellow:hover {
  color: rgba(225, 213, 79, 1);
  transform: scale(1.05);
  color: rgb(255,255,255);
}
</style>
