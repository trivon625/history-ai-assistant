<div class="topic-bg-overlay">
<% if @topic.title.downcase.include?("world war") %>
<%= image_tag "world-war_1.png", class: "bg-img" %>
<% elsif @topic.title.downcase.include?("french revolution") %>
<%= image_tag "french-revolution.png", class: "bg-img" %>
<% elsif @topic.title.downcase.include?("roman empire") %>
<%= image_tag "roman_empire.png", class: "bg-img" %>
<% end %>
<div class="content-layer"></div>
</div>
<div class="content-wrapper">
<div class="glass-card">
  <h1 class="topic-title">Start a new chat for:  <%= @topic.title %></h1>
    <p class="sub-label">New Chat</p>
  <%= simple_form_for [@topic, @chat] do |f| %>
  <div class="form-inputs">
    <%= f.input :title, label: false, placeholder: "What would you like to know?",
    input_html: { class: "custom-input" } %>
  </div>
  <div class="form-action">
    <%= f.button :submit, "Send", class: "btn-send-custom" %>
  </div>
    <% end %>

    <%= link_to "Back", topic_path(@topic), class: "mt-3 d-block" %>
</div>

<style>
.topic-bg-overlay { 
  position: fixed;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 100vw;
  height: 100vh;
  z-index: -1;
  margin: 0;
  padding: 0;
  pointer-events: none;
  }
.bg-img {
  
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.2;
  }
.content-layer {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(253, 246, 227, 0.4);
  z-index: -1;}

.content-layer {
  position: fixed;
  top: 0;
  left: 0;
  width: 100 % ;
  height: 100 % ;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: rgba(253, 246, 227, 0.4);
  z-index: -1;}
  pointer-events: none;

  h1, h3, p, .lead, .display-4, .list-group-item {
    font-family: "Times New Roman", Times, serif !important;
    color: rgb(12,52,112) !important;
  }
  .content-wrapper{
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 80vh;
    
    position: relative;
    z-index: 10;
    margin-top: 35px;
   
  }
  .glass-card {
    background-color: rgb(253, 246, 227);
    padding: 50px 60px;
    border-radius: 35px;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.2);
    width: 90% ;
    max-width; 600px;
    text-align: left;
    pointer-event: auto;
    margin: 0 auto;
  }
  .topic-title {
    font-size: 36px;
    font-weight: 900;
    color: rgb(12,52,112);
    margin-bottom: 15px;
    line-height: 1.1;
    font-family: "Times New Roman", Times, serif !important;
  }
  .sub-label {
    font-size: 26px;
    font-weight: 800;
    font-family: "Times New Roman", Times, serif !important;
    color: rgb(102, 102, 102);
    margin-bottom: 30px;
    display: block;
  }
  .custom-input {
    width: 100% ;
    padding: 12px;
    border: 1.5px solid rgb(204, 204, 204).
    border-radius: 8px;
    margin-bottom: 15px;
    background: rgb(255, 255, 255);
  }
  .btn-send-custom {
    background-color: rgb(12,52,112);
    color: rgb(255, 255, 255);
    width: 120px;
    padding: 10px;
    border-radius: 8px;
    border: none;
    font-weight: bold;
    font-size: 20px;
    font-family: "Times New Roman", Times, serif !important;
    cursur: pointer;
    text-align: center;
    transition: 0.3s;
  }
  .btn-send-custom:hover {
    background-color: rgba(12, 52, 112, 0.9);
    transform: translateY(-2px);
  }
  .back-link {
    display: block;
    margin-top: 20px;
    color: rgb(136, 136, 136);
    text-decoration: none;
  }
  .button-group{
    disply: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  @media (max-width: 767px) {
    .glass-card {
      padding: 30px 20px !important;
      width: 95% !important;
      border-radius: 20px;
      margin-bottm: 20px;
    }
    .content-wrapper {
      padding-bottom: 50 px;
      margin-top: 0 !important;
      height: auto !important;
      min-height: 100vh;

    }
  }
  </style>