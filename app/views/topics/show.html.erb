<div class="topic-bg-overlay">
<% if @topic.title.downcase.include?("world war") %>
<%= image_tag "world-war_1.png", class: "bg-img" %>
<% elsif @topic.title.downcase.include?("french revolution") %>
<%= image_tag "french-revolution.png", class: "bg-img" %>
<% elsif @topic.title.downcase.include?("roman empire") %>
<%= image_tag "roman_empire.png", class: "bg-img" %>
<% end %>
<div class="content-layer"></div>
</div>


<div class="container mt-5" style="max-width: 1200px; position: relative; z-index: 1;">
  <div class="row g-4">
    <div class="col-md-7">
      <div class="p-5 shadow-lg" style="background-color: rgb(253, 246, 227); border-radius: 25px;
         box-shadow: 0 15px 35px rgba(12, 52, 112, 0.2) !important;">
    <h1 class="display-4 text-primary mb-4" style="font-weight: bold;"><%= @topic.title %></h1>
      <p class="lead mb-5" style="font_size: 1.25rem; color: #444;"><%= @topic.description %></p>

    
      <div class="d-flex flex-column flex-md-row justify-content-center align-items-stretch gap-2 mt-4 w100 px-2">
        <%= link_to "Start a New Chat", new_topic_chat_path(@topic), class: "btn btn-chat-custom btn-lg shadow-sm text-center py-3" %>

      
        <button type="button" class="btn btn-quiz-custom btn-lg shadow-sm text-center py-3" data-bs-toggle="modal"
         data-bs-target="#quizModal"
         data-topic-id="<%= @topic.id %>">
        Generate Quiz Question
      </button>
      <%= link_to "← Back to All Topics", topics_path, class: "btn btn-back-custom btn-lg shadow-sm text-center py-3" %>

      </div>
    </div>
  </div>

    <div class="col-md-5">
    <div class="p-4 shadow-lg h-100" style="border-radius: 25px; background-color: rgb(12,52,112);">
      <h3 class="mb-4 text-center text-white">Your Previous Chats in this Topic:</h3>
      <div class="list-group list-group-flush">
        <% @topic.chats.where(user: current_user).each do |chat| %>
          <div class="list-group-item bg-transparent d-flex align-items-center border-bottom py-3">
            
           <%= link_to chat.title, chat_path(chat), class: "text-white text-decoration-none" %>
            <div style="min-width: 30px; text-align: right;">
             <%= button_to chat_path(chat), method: :delete,
                class: "btn btn-sm btn-link text-white p-0 border-0 shadow-none",
                form: { data: { turbo_confirm: "Are you sure you want to delete this chat?" } } do %>
              <i class="fa-regular fa-trash-can" style="color: white !important;"></i>
            <% end %>
          </div>
        </div>
       <% end %>
      </div>
    </div>
  </div>
 </div>
</div>

<div class="modal fade" id="quizModal" tabindex="-1" aria-labelledby="quizModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="quizModalLabel">Quiz Question</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div id="quizContent">Loading quiz...</div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
<script>
let quizLoading = false;

function loadQuiz(topicId, quizContent, handleClick) {
  quizContent.innerHTML = "<p>Loading question...</p>";
  fetch(`/topics/${topicId}/generate_quiz`)
    .then(r => r.json())
    .then(quiz => {
      quizContent.innerHTML = `
        <p class="lead">${quiz.question}</p>
        <div id="quizButtons" class="d-grid gap-2">
          ${quiz.answers.map(a => `<button class="quiz-option btn btn-outline-primary mb-2 w-100" data-correct="${a.correct}">${a.text}</button>`).join('')}
        </div>
        <button id="tryAnother" class="btn btn-outline-secondary mt-3 w-100" style="border-radius: 20px; display:none;">
          Try another question
        </button>
      `;
      document.getElementById("quizButtons").addEventListener("click", handleClick);
      document.getElementById("tryAnother").addEventListener("click", () => {
        loadQuiz(topicId, quizContent, handleClick);
      });
    })
    .catch(() => {
      quizContent.innerHTML = "<p class='text-danger'>Failed to load quiz. Please try again.</p>";
    });
}

document.addEventListener("turbo:load", () => {
  const quizModal = document.getElementById("quizModal");
  const quizContent = document.getElementById("quizContent");

  quizModal.addEventListener("show.bs.modal", async (event) => {
    if (quizLoading) return; // evita duplicar fetchs
    quizLoading = true;

    const button = event.relatedTarget;
    if (!button) return;

    const topicId = button.dataset.topicId;

    const handleClick = (e) => {
      const btn = e.target.closest(".quiz-option");
      if (!btn) return;

      document.getElementById("quizButtons").querySelectorAll(".quiz-option").forEach(b => {
        if (b.dataset.correct === "true") b.classList.replace("btn-outline-primary", "btn-success");
        else if (b === btn) b.classList.replace("btn-outline-primary", "btn-danger");
        b.disabled = true;
      });

      if (btn.dataset.correct === "true") {
        try {
          confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });
        } catch(err) { console.warn(err); }
      }

      document.getElementById("quizButtons").removeEventListener("click", handleClick); // evita duplicados
      document.getElementById("tryAnother").style.display = "block";
      quizLoading = false;
    };

    loadQuiz(topicId, quizContent, handleClick);
  });

  quizModal.addEventListener("hidden.bs.modal", () => {
    quizContent.innerHTML = "Loading quiz...";
    quizLoading = false;
  });
});
</script>

